# API Keys for Questions and Criterias Classifier Service
# Copy this file to .env and fill in your actual API keys

# Hugging Face token (required for some models)
HF_TOKEN=your_huggingface_token_here

# OpenRouter API key (for free tier models)
OPENROUTER_API_KEY=your_openrouter_key_here

# Google AI Studio API key (for Gemini models)
GOOGLE_GENAI_API_KEY=your_google_ai_studio_key_here

# Anthropic API key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI API key (for GPT models)
OPENAI_API_KEY=your_openai_key_here

# Optional: Set to true to enable debug logging
DEBUG=false

# Optional: Set to true to use GPU acceleration
USE_GPU=true
